# Settings for scripts/deploy-infra.ts: copy to .env (cp .env.example .env) and fill in.
# The deployer private key does NOT go here, see docs/DEPLOYMENT.md step 3.

# RPC endpoint of the target chain. Example Polygon PoS mainnet:
RPC_URL=https://polygon-bor-rpc.publicnode.com

# Chain id the RPC must report, protects against deploying to the wrong chain. Polygon PoS mainnet: 137
EXPECTED_CHAIN_ID=137

# true: every issuer can deploy a token suite for itself through the gateway (open factory).
# false: only the addresses in GATEWAY_DEPLOYERS can deploy.
GATEWAY_PUBLIC_DEPLOYMENT=true

# Optional, comma-separated. Wallets allowed to deploy suites ON BEHALF of an issuer (token owner != sender),
# e.g. the platform backend. With an open gateway, issuers deploying for themselves need no entry here.
GATEWAY_DEPLOYERS=

# Optional. Admin wallet that receives ownership of the infrastructure at the end (hardware wallet or multisig).
# Empty: the deployer wallet stays owner.
TREX_OWNER=

# Block confirmations to wait for per transaction (>= 1).
CONFIRMATIONS=3
